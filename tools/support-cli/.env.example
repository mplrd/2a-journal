# support-cli configuration — copy to .env and fill in (.env is gitignored).
#
# API base URL (no trailing slash). Examples:
#   local dev : http://2a.journal.local/api
#   prod      : https://api.2a-trading-tools.com
JOURNAL_API_URL=http://2a.journal.local/api

# Admin account used to read/update tickets. MUST have role=ADMIN.
JOURNAL_ADMIN_EMAIL=
JOURNAL_ADMIN_PASSWORD=
